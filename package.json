{
  "name": "froc-ia",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/walletService.test.ts tests/webhookSignature.test.ts",
    "test:integration": "vitest run tests/walletAndCheckout.test.ts tests/phase2_wallet_integration.test.ts",
    "test:ai": "vitest run tests/phase3_ai_engine.test.ts",
    "test:foundation": "vitest run tests/aiRequestOrchestrator.test.ts",
    "test:tools": "vitest run tests/toolExecutionService.test.ts",
    "test:research-rag": "vitest run tests/researchAndRagEvidence.test.ts",
    "test:memory-durable": "vitest run tests/memoryControl.test.ts tests/memoryPrivacyAndContext.test.ts tests/durableExecutionService.test.ts",
    "test:site-factory": "vitest run tests/siteFactoryPipeline.test.ts tests/operationalObservability.test.ts",
    "test:security-release": "vitest run tests/securityAndReleaseGovernance.test.ts tests/attachmentImportSecurity.test.ts tests/authAndHealthSecurity.test.ts",
    "test:social-search": "vitest run tests/socialSearchOfficialApis.test.ts tests/researchAndRagEvidence.test.ts",
    "test:site-audit": "vitest run tests/fullSiteAuditor.test.ts tests/attachmentImportSecurity.test.ts",
    "test:research-memory-deep": "vitest run tests/socialSearchOfficialApis.test.ts tests/citationUrlResolver.test.ts tests/geminiProviderErrors.test.ts tests/longTermConversationMemory.test.ts tests/longTermMemoryPersistence.test.ts tests/fullSiteAuditor.test.ts",
    "test:rules": "vitest run tests/rules.test.ts",
    "validate:tracker": "node --import tsx scripts/validate-requirement-tracker.ts",
    "validate:production-integrity": "node --import tsx scripts/validate-production-integrity.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "firebase": "^12.17.1",
    "firebase-admin": "14.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "mercadopago": "^3.3.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
