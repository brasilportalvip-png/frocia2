rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && !request.resource.data.keys().hasAny(['tenantId', 'companyId', 'organizationId'])
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'Teste' || request.resource.data.plan == 'Gratuito')
        && (!('creditsRemaining' in request.resource.data) || request.resource.data.creditsRemaining == 0)
        && (!('creditsAvailable' in request.resource.data) || request.resource.data.creditsAvailable == 0)
        && (!('creditsReserved' in request.resource.data) || request.resource.data.creditsReserved == 0)
        && (!('creditsPurchased' in request.resource.data) || request.resource.data.creditsPurchased == 0)
        && (!('creditsConsumed' in request.resource.data) || request.resource.data.creditsConsumed == 0)
        && (!('creditsRefunded' in request.resource.data) || request.resource.data.creditsRefunded == 0);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'email', 'uid', 'role', 'plan',
          'tenantId', 'companyId', 'organizationId',
          'creditsAvailable', 'creditsRemaining', 'creditsReserved',
          'creditsPurchased', 'creditsConsumed', 'creditsRefunded'
        ]);
      allow delete: if isAdmin();
    }

    // Payments Collection (Backend Express / Firebase Admin SDK writes only)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Strict backend-only mutation
    }

    // Credit Transactions Statement (Backend Express / Firebase Admin SDK writes only)
    match /credit_transactions/{txId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Strict backend-only mutation
    }

    // Credit Reservations (Backend Express / Firebase Admin SDK writes only)
    match /credit_reservations/{resId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Financial Reconciliation Cases (Admin read, Backend write)
    match /financial_reconciliation_cases/{caseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Webhook Events Log (Backend Express / Firebase Admin SDK only)
    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    // Conversations Collection
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Messages Collection
    match /messages/{msgId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User Memories Collection
    match /user_memories/{memId} {
      // Backend-only: the API applies consent, tenant checks, TTL, redaction and
      // decryption before returning a user-owned projection.
      allow read, write: if false;
    }

    // Content-free explanation of memory use. Backend writes and API owner
    // projection only; direct clients cannot forge or enumerate audit events.
    match /memory_audit_events/{eventId} {
      allow read, write: if false;
    }

    // Hierarchical conversation memory is encrypted and backend-only. The API
    // applies tenant ownership, retrieval limits and user deletion controls.
    match /conversation_memory_segments/{segmentId} {
      allow read, write: if false;
    }

    // Prompts criptografados, ações de pesquisa e resultados de jobs longos
    // são projetados ao proprietário somente pela API autenticada.
    match /research_jobs/{jobId} {
      allow read, write: if false;
    }

    // Durable execution state, immutable transition events and transactional
    // outbox are exclusively controlled by trusted backend workers.
    match /durable_executions/{executionId} {
      allow read, write: if false;
    }
    match /durable_execution_events/{eventId} {
      allow read, write: if false;
    }
    match /durable_execution_outbox/{outboxId} {
      allow read, write: if false;
    }
    match /durable_domain_events/{eventId} {
      allow read, write: if false;
    }

    // Knowledge Bases Collection
    match /knowledge_bases/{kbId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Knowledge Documents Collection
    match /knowledge_documents/{docId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Knowledge Chunks Collection
    match /knowledge_chunks/{chunkId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // AI Executions Collection (Backend writes, Owner/Admin read)
    match /ai_executions/{execId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Prompt Definitions & Versions (Admin read/write)
    match /prompt_definitions/{promptId} {
      allow read, write: if isAdmin();
    }
    match /prompt_versions/{versionId} {
      allow read, write: if isAdmin();
    }

    // AI Evaluations Collection (Admin read/write)
    match /ai_evaluations/{evalId} {
      allow read, write: if isAdmin();
    }

    // Projects Collection
    match /projects/{projectId} {
  allow create: if isAuthenticated() && (
    request.resource.data.userId == request.auth.uid ||
    isAdmin()
  );

  allow read, delete: if isAuthenticated() && (
    resource.data.userId == request.auth.uid ||
    isAdmin()
  );

  allow update: if isAuthenticated() && (
    isAdmin() ||
    (
      resource.data.userId == request.auth.uid &&
      request.resource.data.userId == request.auth.uid
    )
  );
}

    // Project deployment evidence (Backend writes, Owner/Admin reads)
    match /project_deployments/{deploymentId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Immutable deployment and rollback events (Backend only)
    match /project_deployment_events/{eventId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Site factory specifications, immutable versions, change requests and
    // quality gates are exposed only through the authenticated backend API.
    match /site_factory_projects/{document=**} {
      allow read, write: if false;
    }
    match /site_quality_plans/{planId} {
      allow read, write: if false;
    }

    // Operational telemetry, alerts and distributed resilience state contain
    // internal dimensions and are restricted to the trusted backend.
    match /operational_telemetry_events/{eventId} {
      allow read, write: if false;
    }
    match /operational_alerts/{alertId} {
      allow read, write: if false;
    }
    match /operational_resilience_state/{stateId} {
      allow read, write: if false;
    }

    // Media Generations & Jobs
    match /media_generations/{genId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Backend write only
    }
    match /media_jobs/{jobId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Backend write only
    }

    // Self Evolution Config
    match /self_evolution_config/{configId} {
      allow read, write: if isAdmin();
    }

    // Fallback: Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
