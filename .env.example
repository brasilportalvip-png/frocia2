# ============================================================
# FROC.IA — MODELO DE VARIÁVEIS DE AMBIENTE
# Nunca coloque segredos reais neste arquivo.
# Configure os valores reais somente na Vercel.
# ============================================================

# ------------------------------------------------------------
# APLICAÇÃO
# ------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=https://seu-dominio.vercel.app
# Origens adicionais separadas por vírgula. Deixe vazio se o frontend usa o
# mesmo domínio da API.
TRUSTED_ORIGINS=

# Segredo aleatório com pelo menos 16 caracteres.
# Usado somente pelas rotas internas de manutenção.
INTERNAL_CRON_SECRET=

# ------------------------------------------------------------
# GEMINI — OBRIGATÓRIO EM PRODUÇÃO
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MEDIA_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview
GEMINI_CODE_MODEL=gemini-3.1-pro-preview
GEMINI_VISION_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_FALLBACK_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------
# OPENAI — PESQUISA AGENTIC OPCIONAL
# Ative somente após configurar uma chave com faturamento e homologar custo.
# Sem esta integração, a pesquisa continua no Gemini com grounding.
# ------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_RESEARCH_ENABLED=false
OPENAI_RESEARCH_MODEL=gpt-5.5
OPENAI_RESEARCH_REASONING_EFFORT=high
OPENAI_RESEARCH_MAX_TOOL_CALLS=40

# ------------------------------------------------------------
# PESQUISA OFICIAL EM REDES SOCIAIS — OPCIONAL
# Cada conector usa somente a API oficial. Sem a credencial e a aprovação
# exigidas pela plataforma, a Froc.IA informa o bloqueio e não faz scraping.
# ------------------------------------------------------------

# YouTube Data API v3 — pesquisa de vídeos públicos.
YOUTUBE_DATA_API_KEY=
# Nomes alternativos aceitos: YOUTUBE_API_KEY ou GOOGLE_YOUTUBE_API_KEY.

# Bluesky — o acesso público não exige credencial. O fallback autenticado
# é opcional e usa uma senha de aplicativo, nunca a senha principal.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# X API v2 — recent search conforme o plano da conta de desenvolvedor.
X_BEARER_TOKEN=

# Reddit OAuth — informe um token temporário OU credenciais application-only.
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=frocia2/1.0 by seu_usuario_reddit

# Meta Graph API — defina explicitamente a versão aprovada do aplicativo.
# Instagram requer conta profissional e Instagram Public Content Access.
# Facebook requer Page Public Content Access para pesquisa pública ampliada.
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok Research Tools — exige aprovação e scope research.data.basic.
TIKTOK_RESEARCH_ACCESS_TOKEN=

# REAL IMAGE GENERATION
# Keep disabled until a real provider test succeeds.
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
IMAGE_GENERATION_AVAILABLE="false"
IMAGE_GENERATION_ENABLED="false"

# REAL VIDEO GENERATION
# Keep disabled until a real Veo test succeeds.
VEO_LITE_MODEL="veo-3.1-lite-generate-preview"
VEO_FAST_MODEL="veo-3.1-fast-generate-preview"
VEO_STANDARD_MODEL="veo-3.1-generate-preview"
VIDEO_GENERATION_AVAILABLE="false"
VIDEO_GENERATION_ENABLED="false"
# CARD PAYMENT
# Enable only after a successful real card transaction.
CARD_PAYMENT_AVAILABLE="false"

# INTERNAL CRON SECRET FOR AUTOMATED MAINTENANCE & EXPIRATION

# ------------------------------------------------------------
# FIREBASE FRONTEND — OBRIGATÓRIO EM PRODUÇÃO
# Valores públicos fornecidos pelo Firebase Web App.
# ------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------
# FIREBASE ADMIN — OBRIGATÓRIO EM PRODUÇÃO
# Escolha UMA das duas formas.
# ------------------------------------------------------------

# Opção 1: conta de serviço completa em JSON, em uma única linha.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Opção 2: três variáveis separadas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional: segredo aleatório de alta entropia usado por AES-256-GCM.
# Sem esta chave, a plataforma recusa memórias com dados pessoais em vez de
# armazená-las em texto puro. Gere e configure somente na Vercel.
MEMORY_ENCRYPTION_KEY=

# Usado somente em testes locais com emulador.
FIRESTORE_EMULATOR_HOST=

# ------------------------------------------------------------
# MERCADO PAGO — OBRIGATÓRIO PARA PAGAMENTOS
# ------------------------------------------------------------

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=https://seu-dominio.vercel.app/api/payments/webhook
MERCADO_PAGO_SUCCESS_URL=https://seu-dominio.vercel.app/payment/success
MERCADO_PAGO_PENDING_URL=https://seu-dominio.vercel.app/payment/pending
MERCADO_PAGO_FAILURE_URL=https://seu-dominio.vercel.app/payment/failure

# ------------------------------------------------------------
# AUTOEVOLUÇÃO — OPCIONAL
# Só ative depois de homologar worker, GitHub, CI e rollback.
# ------------------------------------------------------------

SELF_EVOLUTION_ENABLED=false
AUTONOMOUS_PRODUCTION_DEPLOY_ENABLED=false
SELF_EVOLUTION_WORKER_URL=
SELF_EVOLUTION_WORKER_TOKEN=

# ------------------------------------------------------------
# GITHUB — OPCIONAL, USADO PELA AUTOEVOLUÇÃO
# Use GITHUB_TOKEN OU GITHUB_APP_TOKEN, nunca ambos.
# ------------------------------------------------------------

GITHUB_TOKEN=
GITHUB_APP_TOKEN=
GITHUB_OWNER=brasilportalvip-png
GITHUB_REPO=frocia2
GITHUB_BASE_BRANCH=main

# ------------------------------------------------------------
# VERCEL — OPCIONAL PARA AUTOMAÇÕES INTERNAS
# A conexão normal GitHub → Vercel não exige preencher aqui.
# ------------------------------------------------------------

VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# ------------------------------------------------------------
# MONITORAMENTO — OPCIONAL
# ------------------------------------------------------------

MONITORING_API_URL=
MONITORING_API_KEY=

# ------------------------------------------------------------
# DESENVOLVIMENTO LOCAL
# ------------------------------------------------------------

DISABLE_HMR=false
