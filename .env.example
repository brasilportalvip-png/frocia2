# ============================================================
# FROC.IA — MODELO DE VARIÁVEIS DE AMBIENTE
# Nunca coloque segredos reais neste arquivo.
# Configure os valores reais somente na Vercel.
# ============================================================

# ------------------------------------------------------------
# APLICAÇÃO
# ------------------------------------------------------------

NODE_ENV=development
PORT=3000
APP_URL=https://seu-dominio.vercel.app

# Origens adicionais separadas por vírgula.
# Deixe vazio se o frontend usa o mesmo domínio da API.
TRUSTED_ORIGINS=

# Segredos usados somente pelas rotas internas de manutenção.
INTERNAL_CRON_SECRET=
CRON_SECRET=

# ------------------------------------------------------------
# GEMINI — OBRIGATÓRIO EM PRODUÇÃO
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MEDIA_API_KEY=

# Modelo principal atual.
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# Modelo econômico para tarefas rápidas.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Raciocínio, código e visão.
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_CODE_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# Embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Primeiro fallback.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Text-to-Speech atual.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Charon

# Ordem global de continuidade.
GEMINI_MODEL_FAILOVER_CHAIN=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# ------------------------------------------------------------
# PESQUISA OFICIAL EM REDES SOCIAIS — OPCIONAL
# Cada conector usa somente a API oficial.
# ------------------------------------------------------------

# YouTube Data API v3.
YOUTUBE_DATA_API_KEY=

# Bluesky.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# X API v2.
X_BEARER_TOKEN=

# Reddit OAuth.
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=frocia2/1.0 by seu_usuario_reddit

# Meta Graph API.
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# TikTok Research Tools.
TIKTOK_RESEARCH_ACCESS_TOKEN=

# ------------------------------------------------------------
# GERAÇÃO REAL DE IMAGEM
# ------------------------------------------------------------

GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Ative somente depois de teste real aprovado.
IMAGE_GENERATION_AVAILABLE="false"
IMAGE_GENERATION_ENABLED="false"

# ------------------------------------------------------------
# GERAÇÃO REAL DE VÍDEO
# ------------------------------------------------------------

VEO_LITE_MODEL="veo-3.1-lite-generate-preview"
VEO_FAST_MODEL="veo-3.1-fast-generate-preview"
VEO_STANDARD_MODEL="veo-3.1-generate-preview"

# Ative somente depois de teste real aprovado.
VIDEO_GENERATION_AVAILABLE="false"
VIDEO_GENERATION_ENABLED="false"

# ------------------------------------------------------------
# PAGAMENTO COM CARTÃO
# ------------------------------------------------------------

CARD_PAYMENT_AVAILABLE=false

# ------------------------------------------------------------
# FIREBASE FRONTEND — OBRIGATÓRIO EM PRODUÇÃO
# ------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------
# FIREBASE ADMIN — OBRIGATÓRIO EM PRODUÇÃO
# Escolha UMA das duas formas.
# ------------------------------------------------------------

# Opção 1: conta de serviço completa em JSON.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Opção 2: variáveis separadas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------
# BACKUP E MEMÓRIA
# ------------------------------------------------------------

BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

MEMORY_ENCRYPTION_KEY=

# Usado somente em testes locais com emulador.
FIRESTORE_EMULATOR_HOST=

# ------------------------------------------------------------
# MERCADO PAGO — OBRIGATÓRIO PARA PAGAMENTOS
# ------------------------------------------------------------

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

MERCADO_PAGO_WEBHOOK_URL=https://seu-dominio.vercel.app/api/payments/webhook
MERCADO_PAGO_SUCCESS_URL=https://seu-dominio.vercel.app/payment/success
MERCADO_PAGO_PENDING_URL=https://seu-dominio.vercel.app/payment/pending
MERCADO_PAGO_FAILURE_URL=https://seu-dominio.vercel.app/payment/failure

# ------------------------------------------------------------
# AUTOEVOLUÇÃO — OPCIONAL
# Só ative depois de homologar worker, GitHub, CI e rollback.
# ------------------------------------------------------------

SELF_EVOLUTION_ENABLED=false
AUTONOMOUS_PRODUCTION_DEPLOY_ENABLED=false

SELF_EVOLUTION_WORKER_URL=
SELF_EVOLUTION_WORKER_TOKEN=
SELF_EVOLUTION_WORKER_SIGNING_SECRET=

SANDBOX_REPOSITORY_URL=https://github.com/brasilportalvip-png/frocia2.git
SANDBOX_NETWORK_POLICY=restricted
SANDBOX_INSTANCE_ID=

# Engenharia.
ENGINEERING_MODEL=gemini-3.8-flash
ENGINEERING_MAX_REPAIR_ATTEMPTS=3

# ------------------------------------------------------------
# HOMOLOGAÇÃO AUTENTICADA
# ------------------------------------------------------------

BROWSER_TEST_LOGIN_URL=
BROWSER_TEST_USER=
BROWSER_TEST_PASSWORD=

BROWSER_USER_SELECTOR=input[type=email]
BROWSER_PASSWORD_SELECTOR=input[type=password]
BROWSER_SUBMIT_SELECTOR=button[type=submit]

# ------------------------------------------------------------
# COMITÊ ESPECIALISTA / VERIFICAÇÃO INDEPENDENTE
# ------------------------------------------------------------

SPECIALIST_PRODUCT_ACTOR_UID=
SPECIALIST_ARCHITECTURE_ACTOR_UID=
SPECIALIST_UX_UI_ACTOR_UID=
SPECIALIST_FRONTEND_ACTOR_UID=
SPECIALIST_BACKEND_ACTOR_UID=
SPECIALIST_DATA_ACTOR_UID=
SPECIALIST_SECURITY_ACTOR_UID=
SPECIALIST_QA_ACTOR_UID=
SPECIALIST_DEVOPS_ACTOR_UID=
SPECIALIST_INDEPENDENT_VERIFIER_ACTOR_UID=

SPECIALIST_REVIEW_MODEL=gemini-3.8-flash

# Modelo diferente do principal para a segunda revisão.
INDEPENDENT_VERIFIER_MODEL=gemini-3.1-pro-preview

# ------------------------------------------------------------
# GITHUB — OPCIONAL, USADO PELA AUTOEVOLUÇÃO
# ------------------------------------------------------------

GITHUB_READ_TOKEN=

# Use GITHUB_TOKEN OU GITHUB_APP_TOKEN, nunca ambos.
GITHUB_TOKEN=
GITHUB_APP_TOKEN=

GITHUB_OWNER=brasilportalvip-png
GITHUB_REPO=frocia2
GITHUB_BASE_BRANCH=main

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_STATE_SECRET=

# ------------------------------------------------------------
# VERCEL — OPCIONAL PARA AUTOMAÇÕES INTERNAS
# ------------------------------------------------------------

VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# ------------------------------------------------------------
# MONITORAMENTO — OPCIONAL
# ------------------------------------------------------------

MONITORING_API_URL=
MONITORING_API_KEY=

# ------------------------------------------------------------
# DESENVOLVIMENTO LOCAL
# ------------------------------------------------------------

DISABLE_HMR=false