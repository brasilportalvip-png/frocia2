# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_DEFAULT_MODEL="gemini-3.6-flash"
GEMINI_FAST_MODEL="gemini-3.1-flash-lite"
GEMINI_REASONING_MODEL="gemini-3.1-pro-preview"
GEMINI_CODE_MODEL="gemini-3.1-pro-preview"
GEMINI_VISION_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"
GEMINI_FALLBACK_MODEL="gemini-3.6-flash"

# INTERNAL CRON SECRET FOR AUTOMATED MAINTENANCE & EXPIRATION
INTERNAL_CRON_SECRET=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE FRONTEND CONFIG (VITE_*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FIREBASE ADMIN BACKEND CONFIG (SECRETS)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MERCADO PAGO CONFIG (PRODUCTION SECRETS)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_PENDING_URL=
MERCADO_PAGO_FAILURE_URL=
